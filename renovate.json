{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":prHourlyLimitNone"
  ],
  "prConcurrentLimit": 10,
  "timezone": "Europe/Berlin",
  "argocd": {
    "managerFilePatterns": [
      "/infrastructure/kubernetes/apps/.*\\.yaml$/"
    ]
  },
  "terraform": {
    "managerFilePatterns": [
      "/infrastructure/terraform/.*\\.tf$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/infrastructure/kubernetes/.*\\.yaml$/"
    ]
  },
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "packageRules": [
    {
      "description": "Release Rings (docs/adr/0060): an upstream release waits three days, so one the upstream project withdraws never reaches main. Where a registry gives no release date (ghcr.io, code.forgejo.org, every digest), the update is not held forever (minimumReleaseAgeBehaviour timestamp-optional): Ring 0 still verifies it before anything else moves. Renovate itself never merges: Ring 0's merge queue does, one update at a time while main is green (the ring0-queue rule below).",
      "matchPackageNames": [
        "*"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": false,
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "A pin names the version already running, so there is nothing to wait for.",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Ring 0's merge queue (tenants/canary-follower/src/mergequeue.py): the Canary Follower squash-merges PRs with this label one at a time while main is green on Ring 0, and reverts one Ring 0 rejects. Never majors, and never what Ring 0 does not run (it could not verify it): those stay for a person to merge.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "matchFileNames": [
        "!infrastructure/terraform/**",
        "!infrastructure/kubernetes/apps/garage.yaml",
        "!infrastructure/kubernetes/apps/garage-backup.yaml",
        "!infrastructure/kubernetes/tenants/backup-replicator/**",
        "!infrastructure/kubernetes/tenants/collabora/**"
      ],
      "addLabels": [
        "ring0-queue"
      ]
    },
    {
      "description": "One PR per application: an application's images and chart move together, so a failure on Ring 0 reverts one application. admin-tools/test-renovate-groups.py checks that every tenant and every chart-bearing Application has a group.",
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/backup-replicator/**"
      ],
      "groupName": "backup-replicator"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/bulwark/**"
      ],
      "groupName": "bulwark"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/canary-follower/**"
      ],
      "groupName": "canary-follower"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/cnpg-barman-plugin/**",
        "infrastructure/kubernetes/apps/cloudnative-pg.yaml"
      ],
      "groupName": "cloudnative-pg"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/collabora/**"
      ],
      "groupName": "collabora"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/dashboard/**"
      ],
      "groupName": "dashboard"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/euro-office/**"
      ],
      "groupName": "euro-office"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/excalidraw/**"
      ],
      "groupName": "excalidraw"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/forgejo/**"
      ],
      "groupName": "forgejo"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/gallery/**"
      ],
      "groupName": "gallery"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/headscale/**"
      ],
      "groupName": "headscale"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/hermes/**"
      ],
      "groupName": "hermes"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/immich/**"
      ],
      "groupName": "immich"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/jitsi/**"
      ],
      "groupName": "jitsi"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/join/**"
      ],
      "groupName": "join"
    },
    {
      "description": "The Keycloak SPI builds against the Keycloak it runs in, so both move in one PR.",
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/keycloak/**",
        "infrastructure/keycloak-spi/**"
      ],
      "groupName": "keycloak"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/nextcloud/**"
      ],
      "groupName": "nextcloud"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/pod-gateway/**"
      ],
      "groupName": "pod-gateway"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/remediation/**"
      ],
      "groupName": "remediation"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/stalwart/**"
      ],
      "groupName": "stalwart"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/tenants/velero/**"
      ],
      "groupName": "velero"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/apps/cert-manager.yaml",
        "infrastructure/kubernetes/apps/cert-manager-webhook-hetzner.yaml"
      ],
      "groupName": "cert-manager"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/apps/garage.yaml",
        "infrastructure/kubernetes/apps/garage-backup.yaml"
      ],
      "groupName": "garage"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/apps/traefik.yaml"
      ],
      "groupName": "traefik"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/apps/kube-prometheus-stack.yaml",
        "infrastructure/kubernetes/apps/loki-stack.yaml"
      ],
      "groupName": "monitoring"
    },
    {
      "matchFileNames": [
        "infrastructure/kubernetes/bases/**"
      ],
      "groupName": "init jobs"
    },
    {
      "matchFileNames": [
        "infrastructure/terraform/**"
      ],
      "groupName": "terraform providers"
    },
    {
      "matchFileNames": [
        "e2e-tests/**"
      ],
      "groupName": "e2e tests"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "kubectl in the init jobs: one helper image in some twenty files across most tenants. Grouped per application it became a dozen identical PRs, each waiting for its own hour on Ring 0; it holds no data and behaves the same everywhere, so it moves in one PR. After the per-application rules, so it wins.",
      "matchPackageNames": [
        "docker.io/alpine/k8s",
        "alpine/k8s"
      ],
      "groupName": "kubectl image for init jobs"
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "commitMessageTopic": "Helm chart {{depName}}"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "commitMessageTopic": "Docker image {{depName}}"
    },
    {
      "description": "Provided-scope Jakarta APIs must match the Keycloak runtime (EE 10 / ws.rs 3.1 for Keycloak 25); bump manually together with Keycloak",
      "matchPackageNames": [
        "jakarta.ws.rs:jakarta.ws.rs-api"
      ],
      "enabled": false
    }
  ]
}
